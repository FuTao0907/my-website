---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import { render } from 'astro:content';
import { getProjects, projectStatusLabel, formatDate } from '@/utils/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({
    params: { id: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// 相关项目：同标签，排除自己
const allProjects = await getProjects();
const related = allProjects
  .filter((p) => p.id !== project.id && p.data.tags.some((t) => project.data.tags.includes(t)))
  .slice(0, 3);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article>
    <header class="mb-8">
      <div class="flex items-center gap-3 text-sm text-[var(--color-muted)]">
        <span class="px-2 py-0.5 rounded-full border border-[var(--color-border)]">
          {projectStatusLabel[project.data.status]}
        </span>
        <span>开始于 {formatDate(project.data.startDate)}</span>
        {project.data.endDate && <span>· 完成于 {formatDate(project.data.endDate)}</span>}
      </div>
      <h1 class="mt-3 text-3xl md:text-4xl font-bold">{project.data.title}</h1>
      <p class="mt-3 text-lg text-[var(--color-muted)]">{project.data.description}</p>

      <div class="mt-5 flex flex-wrap gap-3">
        {project.data.demo && (
          <a
            href={project.data.demo}
            target="_blank"
            rel="noopener"
            class="px-4 py-2 rounded-md bg-[var(--color-accent)] text-white text-sm hover:opacity-90"
          >
            在线演示 ↗
          </a>
        )}
        {project.data.repo && (
          <a
            href={project.data.repo}
            target="_blank"
            rel="noopener"
            class="px-4 py-2 rounded-md border border-[var(--color-border)] text-sm hover:bg-[var(--color-border)]"
          >
            源码 ↗
          </a>
        )}
      </div>
    </header>

    {project.data.cover ? (
      <img
        src={project.data.cover}
        alt={project.data.title}
        class="w-full rounded-lg border border-[var(--color-border)]"
      />
    ) : (
      <ProjectCover seed={project.id} title={project.data.title} ratio="21/9" />
    )}

    <div class="mt-10 leading-relaxed prose-content">
      <Content />
    </div>

    {project.data.tech.length > 0 && (
      <footer class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <h2 class="text-sm font-medium text-[var(--color-muted)]">技术栈</h2>
        <div class="mt-2 flex flex-wrap gap-2">
          {project.data.tech.map((t) => (
            <span class="px-3 py-1 rounded-full border border-[var(--color-border)] text-sm">{t}</span>
          ))}
        </div>
      </footer>
    )}

    {related.length > 0 && (
      <section class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <h2 class="text-sm font-medium text-[var(--color-muted)]">相关项目</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <a
              href={`/projects/${p.id}`}
              class="block p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors"
            >
              <h3 class="font-medium">{p.data.title}</h3>
              <p class="mt-1 text-sm text-[var(--color-muted)] line-clamp-2">{p.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

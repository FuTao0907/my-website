---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getProjects, projectStatusLabel } from '@/utils/projects';

const all = await getProjects();

// 提取所有技术栈
const allTechs = Array.from(new Set(all.flatMap((p) => p.data.tech))).sort();

// featured 置顶（全量渲染；筛选在客户端按 URL query 进行——见底部 is:inline 脚本）
const sorted = [...all].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const tabs = [
  { key: 'all', label: '全部' },
  { key: 'active', label: '进行中' },
  { key: 'completed', label: '已完结' },
  { key: 'archived', label: '归档' },
];
---

<BaseLayout title="项目" description="Ange 的灵感项目陈列室">
  <h1 class="text-3xl font-bold">项目</h1>
  <p class="mt-2 text-[var(--color-muted)]">做过的小项目，记录想法从冒出来到落地的过程。</p>

  <nav class="mt-6 flex gap-2 text-sm flex-wrap">
    {
      tabs.map((t) => (
        <a
          href={`/projects?status=${t.key}`}
          data-status-tab={t.key}
          data-filter-link
          class="px-3 py-1.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-border)] transition-colors"
        >
          {t.label}
        </a>
      ))
    }
  </nav>

  <!-- 技术栈筛选 -->
  {allTechs.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <a
        href="/projects"
        data-tech-tab="all"
        data-filter-link
        class="px-2 py-1 rounded-full text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        全部技术
      </a>
      {allTechs.map((tech) => (
        <a
          href={`/projects?tech=${encodeURIComponent(tech)}`}
          data-tech-tab={tech}
          data-filter-link
          class="px-2 py-1 rounded-full text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors"
        >
          #{tech}
        </a>
      ))}
    </div>
  )}

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      sorted.map((p) => (
        <a
          href={`/projects/${p.id}`}
          class="project-card group block"
          data-status={p.data.status}
          data-tech={p.data.tech.join(',')}
        >
          {p.data.cover ? (
            <img
              src={p.data.cover}
              alt={p.data.title}
              class="w-full rounded-lg border border-[var(--color-border)] object-cover"
              style="aspect-ratio: 16/9"
              loading="lazy"
            />
          ) : (
            <ProjectCover seed={p.id} title={p.data.title} />
          )}
          <div class="mt-3">
            <div class="flex items-center gap-2 text-xs text-[var(--color-muted)]">
              <span class="px-2 py-0.5 rounded-full border border-[var(--color-border)]">
                {projectStatusLabel[p.data.status]}
              </span>
              {p.data.featured && <span class="text-[var(--color-accent)]">★ 推荐</span>}
            </div>
            <h2 class="mt-2 font-semibold group-hover:text-[var(--color-accent)] transition-colors">
              {p.data.title}
              <span aria-hidden="true" class="inline-block ml-1 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all">→</span>
            </h2>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{p.data.description}</p>
            {p.data.tech.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
                {p.data.tech.map((t) => (
                  <span class="text-[var(--color-muted)]">#{t}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))
    }
  </div>

  <!-- 空态：默认隐藏，由客户端脚本按筛选结果显示 -->
  <div id="empty-filter" class="hidden">
    <EmptyState
      icon="🔍"
      title="没有符合筛选条件的项目"
      description="换个筛选条件试试，或者看看全部项目。"
      actionHref="/projects"
      actionLabel="清除筛选"
    />
  </div>
  <div id="empty-none" class="hidden">
    <EmptyState
      icon="📭"
      title="还没有项目"
      description="做过的项目会陈列在这里，包括灵感和落地过程。"
      actionHref="/notes"
      actionLabel="看看一闪念"
    />
  </div>
</BaseLayout>

<script is:inline>
  // 客户端筛选（P1-7）：静态托管下 URL query 在构建时不可用，改为客户端解析过滤
  (function () {
    var cards = Array.prototype.slice.call(document.querySelectorAll('.project-card'));
    var emptyFilter = document.getElementById('empty-filter');
    var emptyNone = document.getElementById('empty-none');
    var statusTabs = Array.prototype.slice.call(document.querySelectorAll('[data-status-tab]'));
    var techTabs = Array.prototype.slice.call(document.querySelectorAll('[data-tech-tab]'));
    if (!cards.length) return;

    var ACTIVE_STATUS = 'bg-[var(--color-accent)] text-[var(--color-accent-fg)] px-3 py-1.5 rounded-full transition-colors';
    var IDLE_STATUS = 'border border-[var(--color-border)] hover:bg-[var(--color-border)] px-3 py-1.5 rounded-full transition-colors';
    var ACTIVE_TECH = 'bg-[var(--color-accent)] text-[var(--color-accent-fg)] px-2 py-1 rounded-full transition-colors';
    var IDLE_TECH = 'text-[var(--color-muted)] hover:text-[var(--color-accent)] px-2 py-1 rounded-full transition-colors';

    function apply() {
      var params = new URLSearchParams(location.search);
      var status = params.get('status') || 'all';
      var tech = params.get('tech') || 'all';
      var visible = 0;
      cards.forEach(function (card) {
        var ok =
          (status === 'all' || card.dataset.status === status) &&
          (tech === 'all' || card.dataset.tech.split(',').indexOf(tech) >= 0);
        card.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });
      statusTabs.forEach(function (a) {
        a.className = a.dataset.statusTab === status ? ACTIVE_STATUS : IDLE_STATUS;
      });
      techTabs.forEach(function (a) {
        a.className = a.dataset.techTab === tech ? ACTIVE_TECH : IDLE_TECH;
      });
      var hasFilter = status !== 'all' || tech !== 'all';
      var showEmpty = emptyFilter && emptyNone ? (visible === 0) : false;
      if (showEmpty) {
        emptyFilter.style.display = hasFilter ? 'block' : 'none';
        emptyNone.style.display = hasFilter ? 'none' : 'block';
      } else {
        if (emptyFilter) emptyFilter.style.display = 'none';
        if (emptyNone) emptyNone.style.display = 'none';
      }
    }

    // 点击筛选链接：合并保留另一维参数后 pushState，无刷新过滤
    document.querySelectorAll('[data-filter-link]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        var cur = new URLSearchParams(location.search);
        var next = new URLSearchParams((a.getAttribute('href') || '').split('?')[1] || '');
        if (a.hasAttribute('data-status-tab')) {
          if (cur.has('tech')) next.set('tech', cur.get('tech'));
          else next.delete('tech');
        }
        if (a.hasAttribute('data-tech-tab')) {
          if (cur.has('status')) next.set('status', cur.get('status'));
          else next.delete('status');
        }
        history.pushState({}, '', '?' + next.toString());
        apply();
      });
    });
    window.addEventListener('popstate', apply);
    apply();
  })();
</script>

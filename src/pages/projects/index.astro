---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import { getProjects, projectStatusLabel } from '@/utils/projects';

const all = await getProjects();
const filter = Astro.url.searchParams.get('status') ?? 'all';
const techFilter = Astro.url.searchParams.get('tech') ?? 'all';

// 提取所有技术栈
const allTechs = Array.from(new Set(all.flatMap((p) => p.data.tech))).sort();

let filtered = filter === 'all' ? all : all.filter((p) => p.data.status === filter);
if (techFilter !== 'all') {
  filtered = filtered.filter((p) => p.data.tech.includes(techFilter));
}

// featured 置顶
const sorted = [...filtered].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});

const tabs = [
  { key: 'all', label: '全部' },
  { key: 'active', label: '进行中' },
  { key: 'completed', label: '已完结' },
  { key: 'archived', label: '归档' },
];
---

<BaseLayout title="项目" description="Ange 的灵感项目陈列室">
  <h1 class="text-3xl font-bold">项目</h1>
  <p class="mt-2 text-[var(--color-muted)]">做过的小项目，记录想法从冒出来到落地的过程。</p>

  <nav class="mt-6 flex gap-2 text-sm flex-wrap">
    {
      tabs.map((t) => (
        <a
          href={`/projects?status=${t.key}${techFilter !== 'all' ? `&tech=${techFilter}` : ''}`}
          class:list={[
            'px-3 py-1.5 rounded-full transition-colors',
            filter === t.key
              ? 'bg-[var(--color-accent)] text-white'
              : 'border border-[var(--color-border)] hover:bg-[var(--color-border)]',
          ]}
        >
          {t.label}
        </a>
      ))
    }
  </nav>

  <!-- 技术栈筛选 -->
  {allTechs.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <a
        href={`/projects?status=${filter}`}
        class:list={[
          'px-2 py-1 rounded-full transition-colors',
          techFilter === 'all'
            ? 'bg-[var(--color-accent)] text-white'
            : 'text-[var(--color-muted)] hover:text-[var(--color-accent)]',
        ]}
      >
        全部技术
      </a>
      {allTechs.map((tech) => (
        <a
          href={`/projects?status=${filter}&tech=${tech}`}
          class:list={[
            'px-2 py-1 rounded-full transition-colors',
            techFilter === tech
              ? 'bg-[var(--color-accent)] text-white'
              : 'text-[var(--color-muted)] hover:text-[var(--color-accent)]',
          ]}
        >
          #{tech}
        </a>
      ))}
    </div>
  )}

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      sorted.map((p) => (
        <a href={`/projects/${p.id}`} class="group block">
          {p.data.cover ? (
            <img
              src={p.data.cover}
              alt={p.data.title}
              class="w-full rounded-lg border border-[var(--color-border)] object-cover"
              style="aspect-ratio: 16/9"
              loading="lazy"
            />
          ) : (
            <ProjectCover seed={p.id} title={p.data.title} />
          )}
          <div class="mt-3">
            <div class="flex items-center gap-2 text-xs text-[var(--color-muted)]">
              <span class="px-2 py-0.5 rounded-full border border-[var(--color-border)]">
                {projectStatusLabel[p.data.status]}
              </span>
              {p.data.featured && <span class="text-[var(--color-accent)]">★ 推荐</span>}
            </div>
            <h2 class="mt-2 font-semibold group-hover:text-[var(--color-accent)] transition-colors">
              {p.data.title}
            </h2>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{p.data.description}</p>
            {p.data.tech.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
                {p.data.tech.map((t) => (
                  <span class="text-[var(--color-muted)]">#{t}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))
    }
  </div>

  {sorted.length === 0 && (
    <p class="mt-10 text-[var(--color-muted)]">这个分类下还没有项目。</p>
  )}
</BaseLayout>

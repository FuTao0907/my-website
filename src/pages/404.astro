---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <section class="py-24 text-center">
    <h1 class="text-6xl font-bold text-[var(--color-accent)]">404</h1>
    <p class="mt-4 text-[var(--color-muted)]">这个页面不存在。</p>
    <a href="/" class="mt-8 inline-block text-[var(--color-accent)] hover:underline">回到首页 →</a>
  </section>
</BaseLayout>

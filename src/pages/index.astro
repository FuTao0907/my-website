---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '@/utils/posts';
import { SITE } from '@/config';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 3);
---

<BaseLayout>
  <section class="py-16 md:py-24">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight">
      你好，我是 <span class="text-[var(--color-accent)]">Ange</span>。
    </h1>
    <p class="mt-6 text-lg text-[var(--color-muted)] max-w-2xl leading-relaxed">
      前端工程师。这里是我的数字名片、项目陈列室与内容自留地——
      记录灵感项目、沉淀技术笔记、收藏喜欢的音乐和书。
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/projects"
        class="px-5 py-2.5 rounded-md bg-[var(--color-accent)] text-white text-sm font-medium hover:opacity-90 transition-opacity"
      >
        看看我的项目
      </a>
      <a
        href="/about"
        class="px-5 py-2.5 rounded-md border border-[var(--color-border)] text-sm font-medium hover:bg-[var(--color-border)] transition-colors"
      >
        了解更多
      </a>
    </div>
  </section>

  <section class="py-10 border-t border-[var(--color-border)]">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">最近博客</h2>
      <a href="/blog" class="text-sm text-[var(--color-accent)] hover:underline">全部 →</a>
    </div>
    <ul class="mt-6 space-y-5">
      {
        recent.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block">
              <div class="text-sm text-[var(--color-muted)]">{formatDate(post.data.published)}</div>
              <h3 class="mt-0.5 font-medium group-hover:text-[var(--color-accent)] transition-colors">
                {post.data.title}
              </h3>
            </a>
          </li>
        ))
      }
    </ul>
    {recent.length === 0 && <p class="mt-4 text-[var(--color-muted)] text-sm">还没有文章。</p>}
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedPosts, formatDate, readingMinutes } from '@/utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const all = await getPublishedPosts();
const index = all.findIndex((p) => p.id === post.id);
const prev = all[index + 1];
const next = all[index - 1];
const minutes = readingMinutes(post.body ?? '');
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article>
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold leading-tight">{post.data.title}</h1>
      <div class="mt-3 text-sm text-[var(--color-muted)] flex flex-wrap gap-x-4 gap-y-1">
        <time datetime={post.data.published.toISOString()}>
          {formatDate(post.data.published)}
        </time>
        <span>约 {minutes} 分钟</span>
        {post.data.tags.length > 0 && (
          <span>标签：{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
        )}
      </div>
    </header>

    <div class="prose-content text-[var(--color-fg)] leading-relaxed">
      <Content />
    </div>

    <nav class="mt-16 pt-8 border-t border-[var(--color-border)] grid grid-cols-2 gap-4 text-sm">
      {prev ? (
        <a href={`/blog/${prev.id}`} class="hover:text-[var(--color-accent)]">
          <span class="text-[var(--color-muted)] block">← 上一篇</span>
          {prev.data.title}
        </a>
      ) : (
        <span></span>
      )}
      {next && (
        <a href={`/blog/${next.id}`} class="text-right hover:text-[var(--color-accent)]">
          <span class="text-[var(--color-muted)] block">下一篇 →</span>
          {next.data.title}
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

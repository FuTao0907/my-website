---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Item = CollectionEntry<'videos'>;
const all = (await getCollection('videos')) as Item[];
const items = all.filter((v) => !import.meta.env.PROD || !v.data.draft);

const sort = Astro.url.searchParams.get('sort') ?? 'recent';
const status = Astro.url.searchParams.get('status') ?? 'all';

let filtered = items;
if (status !== 'all') {
  filtered = filtered.filter((item) => item.data.status === status);
}

const sorted =
  sort === 'rating'
    ? [...filtered].sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
    : [...filtered].sort(
        (a, b) => (b.data.finishedDate?.valueOf() ?? 0) - (a.data.finishedDate?.valueOf() ?? 0),
      );

const excerpt = (body: string) => body.replace(/[#>*`]/g, '').trim().slice(0, 140);
---

<BaseLayout title="影视 / 视频" description="Ange 看过的影视与视频">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="text-3xl font-bold">影视 / 视频</h1>
    <div class="flex flex-wrap gap-4 text-sm">
      <!-- 排序 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">排序：</span>
        <a href="/collections/videos" class={sort === 'recent' ? 'text-[var(--color-accent)]' : ''}>最近</a>
        <a href="/collections/videos?sort=rating" class={sort === 'rating' ? 'text-[var(--color-accent)]' : ''}>评分</a>
      </div>
      <!-- 状态筛选 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">状态：</span>
        <a href="/collections/videos" class={status === 'all' ? 'text-[var(--color-accent)]' : ''}>全部</a>
        <a href="/collections/videos?status=wishlist" class={status === 'wishlist' ? 'text-[var(--color-accent)]' : ''}>想看</a>
        <a href="/collections/videos?status=ongoing" class={status === 'ongoing' ? 'text-[var(--color-accent)]' : ''}>在看</a>
        <a href="/collections/videos?status=finished" class={status === 'finished' ? 'text-[var(--color-accent)]' : ''}>看过</a>
      </div>
    </div>
  </div>

  <ul class="mt-8 space-y-4">
    {
      sorted.map((v) => (
        <li>
          <a href={`/collections/videos/${v.id}`} class="block p-5 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-semibold group-hover:text-[var(--color-accent)]">{v.data.title}</h2>
              {v.data.rating && (
                <span class="text-[var(--color-accent)]">{'★'.repeat(Math.round(v.data.rating))}</span>
              )}
            </div>
            <div class="mt-1 text-sm text-[var(--color-muted)]">
              {v.data.creator}
              {v.data.finishedDate && ` · ${v.data.finishedDate.getFullYear()} 年看`}
            </div>
            {v.body && <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">{excerpt(v.body)}…</p>}
          </a>
        </li>
      ))
    }
  </ul>
  {sorted.length === 0 && <p class="mt-8 text-[var(--color-muted)] text-sm">没有符合条件的内容。</p>}
</BaseLayout>

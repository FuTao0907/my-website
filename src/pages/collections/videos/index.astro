---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Item = CollectionEntry<'videos'>;
const all = (await getCollection('videos')) as Item[];
const items = all.filter((v) => !import.meta.env.PROD || !v.data.draft);

// 服务端按最近完成时间渲染（默认序）；sort/status 筛选在客户端按 URL query 进行
const sorted = [...items].sort(
  (a, b) => (b.data.finishedDate?.valueOf() ?? 0) - (a.data.finishedDate?.valueOf() ?? 0),
);
const excerpt = (body: string) => body.replace(/[#>*`]/g, '').trim().slice(0, 140);
---

<BaseLayout title="影视 / 视频" description="Ange 看过的影视与视频">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="text-3xl font-bold">影视 / 视频</h1>
    <div class="flex flex-wrap gap-4 text-sm">
      <!-- 排序 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">排序：</span>
        <a href="/collections/videos" data-sort-tab="recent" data-filter-link class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">最近</a>
        <a href="/collections/videos?sort=rating" data-sort-tab="rating" data-filter-link class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">评分</a>
      </div>
      <!-- 状态筛选 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">状态：</span>
        <a href="/collections/videos" data-status-tab="all" data-filter-link class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">全部</a>
        <a href="/collections/videos?status=wishlist" data-status-tab="wishlist" data-filter-link class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">想看</a>
        <a href="/collections/videos?status=ongoing" data-status-tab="ongoing" data-filter-link class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">在看</a>
        <a href="/collections/videos?status=finished" data-status-tab="finished" data-filter-link class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">看过</a>
      </div>
    </div>
  </div>

  <ul id="item-list" class="mt-8 space-y-4">
    {
      sorted.map((v) => (
        <li
          class="item-card"
          data-status={v.data.status}
          data-rating={v.data.rating ?? 0}
          data-date={v.data.finishedDate?.valueOf() ?? 0}
        >
          <a href={`/collections/videos/${v.id}`} class="group block p-5 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-semibold group-hover:text-[var(--color-accent)]">
                {v.data.title}
                <span aria-hidden="true" class="inline-block ml-1 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all">→</span>
              </h2>
              {v.data.rating && (
                <span class="text-[var(--color-accent)]">{'★'.repeat(Math.round(v.data.rating))}</span>
              )}
            </div>
            <div class="mt-1 text-sm text-[var(--color-muted)]">
              {v.data.creator}
              {v.data.finishedDate && ` · ${v.data.finishedDate.getFullYear()} 年看`}
            </div>
            {v.body && <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">{excerpt(v.body)}…</p>}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- 空态：默认隐藏，由客户端脚本按筛选结果显示 -->
  <div id="empty-filter" class="hidden">
    <EmptyState
      icon="🔍"
      title="没有符合筛选条件的影视"
      description="换个状态筛选看看，或者查看全部影视。"
      actionHref="/collections/videos"
      actionLabel="清除筛选"
    />
  </div>
  <div id="empty-none" class="hidden">
    <EmptyState
      icon="📭"
      title="影视收藏还是空的"
      description="看过的影视和视频会收藏在这里，附上评分和短评。"
      actionHref="/collections"
      actionLabel="回收藏首页"
    />
  </div>
</BaseLayout>

<script is:inline>
  // 客户端筛选/排序（P1-7）：静态托管下 URL query 在构建时不可用，改为客户端解析过滤
  (function () {
    var list = document.getElementById('item-list');
    var cards = Array.prototype.slice.call(document.querySelectorAll('.item-card'));
    var emptyFilter = document.getElementById('empty-filter');
    var emptyNone = document.getElementById('empty-none');
    var sortTabs = Array.prototype.slice.call(document.querySelectorAll('[data-sort-tab]'));
    var statusTabs = Array.prototype.slice.call(document.querySelectorAll('[data-status-tab]'));
    if (!cards.length) return;

    var ACTIVE = 'text-[var(--color-accent)]';
    var IDLE = 'text-[var(--color-muted)] hover:text-[var(--color-accent)]';

    function apply() {
      var params = new URLSearchParams(location.search);
      var sort = params.get('sort') || 'recent';
      var status = params.get('status') || 'all';
      var visible = cards.filter(function (card) {
        return status === 'all' || card.dataset.status === status;
      });
      visible.sort(function (a, b) {
        if (sort === 'rating') return (+b.dataset.rating) - (+a.dataset.rating);
        return (+b.dataset.date) - (+a.dataset.date);
      });
      visible.forEach(function (card) {
        card.style.display = '';
        list.appendChild(card);
      });
      cards.forEach(function (card) {
        if (visible.indexOf(card) < 0) card.style.display = 'none';
      });
      sortTabs.forEach(function (a) {
        a.className = a.dataset.sortTab === sort ? ACTIVE : IDLE;
      });
      statusTabs.forEach(function (a) {
        a.className = a.dataset.statusTab === status ? ACTIVE : IDLE;
      });
      var hasFilter = status !== 'all';
      if (visible.length === 0) {
        emptyFilter.style.display = hasFilter ? 'block' : 'none';
        emptyNone.style.display = hasFilter ? 'none' : 'block';
      } else {
        emptyFilter.style.display = 'none';
        emptyNone.style.display = 'none';
      }
    }

    document.querySelectorAll('[data-filter-link]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        var cur = new URLSearchParams(location.search);
        var next = new URLSearchParams((a.getAttribute('href') || '').split('?')[1] || '');
        if (a.hasAttribute('data-sort-tab')) {
          if (cur.has('status')) next.set('status', cur.get('status'));
          else next.delete('status');
        }
        if (a.hasAttribute('data-status-tab')) {
          if (cur.has('sort')) next.set('sort', cur.get('sort'));
          else next.delete('sort');
        }
        history.pushState({}, '', next.toString() ? '?' + next.toString() : '/collections/videos');
        apply();
      });
    });
    window.addEventListener('popstate', apply);
    apply();
  })();
</script>

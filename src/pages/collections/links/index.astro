---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Item = CollectionEntry<'links'>;
const all = (await getCollection('links')) as Item[];
const items = all.filter((l) => !import.meta.env.PROD || !l.data.draft);

const sort = Astro.url.searchParams.get('sort') ?? 'recent';
const status = Astro.url.searchParams.get('status') ?? 'all';

let filtered = items;
if (status !== 'all') {
  filtered = filtered.filter((item) => item.data.status === status);
}

const sorted =
  sort === 'rating'
    ? [...filtered].sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
    : [...filtered].sort(
        (a, b) => (b.data.finishedDate?.valueOf() ?? 0) - (a.data.finishedDate?.valueOf() ?? 0),
      );

const excerpt = (body: string) => body.replace(/[#>*`]/g, '').trim().slice(0, 140);
---

<BaseLayout title="收藏链接" description="值得反复看的站点与链接">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="text-3xl font-bold">收藏链接</h1>
    <div class="flex flex-wrap gap-4 text-sm">
      <!-- 排序 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">排序：</span>
        <a href="/collections/links" class={sort === 'recent' ? 'text-[var(--color-accent)]' : ''}>最近</a>
        <a href="/collections/links?sort=rating" class={sort === 'rating' ? 'text-[var(--color-accent)]' : ''}>评分</a>
      </div>
      <!-- 状态筛选 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">状态：</span>
        <a href="/collections/links" class={status === 'all' ? 'text-[var(--color-accent)]' : ''}>全部</a>
        <a href="/collections/links?status=wishlist" class={status === 'wishlist' ? 'text-[var(--color-accent)]' : ''}>待看</a>
        <a href="/collections/links?status=ongoing" class={status === 'ongoing' ? 'text-[var(--color-accent)]' : ''}>常看</a>
        <a href="/collections/links?status=finished" class={status === 'finished' ? 'text-[var(--color-accent)]' : ''}>归档</a>
      </div>
    </div>
  </div>

  <ul class="mt-8 space-y-4">
    {
      sorted.map((l) => (
        <li>
          <a href={`/collections/links/${l.id}`} class="block p-5 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-semibold group-hover:text-[var(--color-accent)]">{l.data.title}</h2>
              <span class="text-sm text-[var(--color-muted)]">{l.data.site}</span>
            </div>
            {l.body && (
              <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">{excerpt(l.body)}…</p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  {sorted.length === 0 && <p class="mt-8 text-[var(--color-muted)] text-sm">没有符合条件的内容。</p>}
</BaseLayout>

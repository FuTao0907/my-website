---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Item = CollectionEntry<'music'>;
const all = (await getCollection('music')) as Item[];
const items = all.filter((m) => !import.meta.env.PROD || !m.data.draft);

const sort = Astro.url.searchParams.get('sort') ?? 'recent';
const status = Astro.url.searchParams.get('status') ?? 'all';

let filtered = items;
if (status !== 'all') {
  filtered = filtered.filter((item) => item.data.status === status);
}

const sorted =
  sort === 'rating'
    ? [...filtered].sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
    : [...filtered].sort(
        (a, b) => (b.data.finishedDate?.valueOf() ?? 0) - (a.data.finishedDate?.valueOf() ?? 0),
      );

const excerpt = (body: string) => body.replace(/[#>*`]/g, '').trim().slice(0, 140);
---

<BaseLayout title="音乐" description="Ange 喜欢的音乐">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="text-3xl font-bold">音乐</h1>
    <div class="flex flex-wrap gap-4 text-sm">
      <!-- 排序 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">排序：</span>
        <a href="/collections/music" class={sort === 'recent' ? 'text-[var(--color-accent)]' : ''}>最近</a>
        <a href="/collections/music?sort=rating" class={sort === 'rating' ? 'text-[var(--color-accent)]' : ''}>评分</a>
      </div>
      <!-- 状态筛选 -->
      <div class="flex gap-2">
        <span class="text-[var(--color-muted)]">状态：</span>
        <a href="/collections/music" class={status === 'all' ? 'text-[var(--color-accent)]' : ''}>全部</a>
        <a href="/collections/music?status=wishlist" class={status === 'wishlist' ? 'text-[var(--color-accent)]' : ''}>想听</a>
        <a href="/collections/music?status=ongoing" class={status === 'ongoing' ? 'text-[var(--color-accent)]' : ''}>常听</a>
        <a href="/collections/music?status=finished" class={status === 'finished' ? 'text-[var(--color-accent)]' : ''}>已弃</a>
      </div>
    </div>
  </div>

  <ul class="mt-8 space-y-4">
    {
      sorted.map((m) => (
        <li class="p-5 rounded-lg border border-[var(--color-border)]">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-semibold">{m.data.title}</h2>
            {m.data.rating && (
              <span class="text-[var(--color-accent)]">{'★'.repeat(Math.round(m.data.rating))}</span>
            )}
          </div>
          <div class="mt-1 text-sm text-[var(--color-muted)]">
            {m.data.artist}
            {m.data.album && ` · ${m.data.album}`}
            {m.data.genre && ` · ${m.data.genre}`}
          </div>
          {m.body && <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">{excerpt(m.body)}…</p>}
        </li>
      ))
    }
  </ul>
  {sorted.length === 0 && <p class="mt-8 text-[var(--color-muted)] text-sm">没有符合条件的内容。</p>}
</BaseLayout>

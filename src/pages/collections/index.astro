---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books')).filter((b) => !import.meta.env.PROD || !b.data.draft);
const music = (await getCollection('music')).filter((m) => !import.meta.env.PROD || !m.data.draft);
const novels = (await getCollection('novels')).filter((n) => !import.meta.env.PROD || !n.data.draft);
const videos = (await getCollection('videos')).filter((v) => !import.meta.env.PROD || !v.data.draft);
const links = (await getCollection('links')).filter((l) => !import.meta.env.PROD || !l.data.draft);

const cats = [
  { path: '/collections/books', label: '书单', icon: '📚', count: books.length },
  { path: '/collections/music', label: '音乐', icon: '🎵', count: music.length },
  { path: '/collections/novels', label: '网文', icon: '📖', count: novels.length },
  { path: '/collections/videos', label: '影视 / 视频', icon: '🎬', count: videos.length },
  { path: '/collections/links', label: '收藏链接', icon: '🔗', count: links.length },
];

// 最近更新：混合所有品类按时间排序
const recent = [
  ...books.map((item) => ({ ...item, category: 'books', categoryName: '书籍' })),
  ...music.map((item) => ({ ...item, category: 'music', categoryName: '音乐' })),
  ...novels.map((item) => ({ ...item, category: 'novels', categoryName: '网文' })),
  ...videos.map((item) => ({ ...item, category: 'videos', categoryName: '视频' })),
  ...links.map((item) => ({ ...item, category: 'links', categoryName: '链接' })),
]
  .sort((a, b) => {
    const aDate = a.data.finishedDate ?? new Date(0);
    const bDate = b.data.finishedDate ?? new Date(0);
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 5);
---

<BaseLayout title="收藏" description="Ange 喜欢但怕忘的东西：书、音乐、网文、影视">
  <meta name="pagefind-ignore" content="true" />
  <h1 class="text-3xl font-bold">收藏</h1>
  <p class="mt-2 text-[var(--color-muted)]">
    我喜欢但怕忘的东西，每条都写了我的评分和短评。
  </p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      cats.map((c) => (
        <a
          href={c.path}
          class="block p-6 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors"
        >
          <div class="text-3xl">{c.icon}</div>
          <div class="mt-3 font-semibold">{c.label}</div>
          <div class="mt-1 text-sm text-[var(--color-muted)]">{c.count} 条</div>
        </a>
      ))
    }
    <a
      href="/collections/stats"
      class="block p-6 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors"
    >
      <div class="text-3xl">📊</div>
      <div class="mt-3 font-semibold">统计</div>
      <div class="mt-1 text-sm text-[var(--color-muted)]">看看数据</div>
    </a>
  </div>

  <!-- 最近更新 -->
  {recent.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-semibold mb-6">最近更新</h2>
      <ul class="space-y-4">
        {recent.map((item) => (
          <li>
            <a href={`/collections/${item.category}/${item.id}`} class="group block p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors">
              <div class="text-sm text-[var(--color-muted)]">{item.categoryName}</div>
              <h3 class="mt-1 font-medium group-hover:text-[var(--color-accent)] transition-colors">{item.data.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

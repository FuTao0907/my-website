---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getCollection, type CollectionEntry } from 'astro:content';

type CollectionMap = {
  books: CollectionEntry<'books'>;
  music: CollectionEntry<'music'>;
  novels: CollectionEntry<'novels'>;
  videos: CollectionEntry<'videos'>;
  links: CollectionEntry<'links'>;
};

const categoryNames: Record<string, string> = {
  books: '书单',
  music: '音乐',
  novels: '网文',
  videos: '影视 / 视频',
  links: '收藏链接',
};

export async function getStaticPaths() {
  const categories = ['books', 'music', 'novels', 'videos', 'links'] as const;
  const paths: { params: { category: string; slug: string }; props: { item: CollectionEntry<'books' | 'music' | 'novels' | 'videos' | 'links'> } }[] = [];

  for (const category of categories) {
    const items = await getCollection(category);
    for (const item of items) {
      paths.push({
        params: { category, slug: item.id },
        props: { item },
      });
    }
  }

  return paths;
}

const { category, slug } = Astro.params;
const { item } = Astro.props;
const { Content } = await render(item as any);
const categoryName = categoryNames[category ?? ''] ?? '收藏';
const data = item.data as any;
---

<BaseLayout title={data.title} description={data.summary ?? data.title}>
  <!-- 面包屑 -->
  <nav class="text-sm text-[var(--color-muted)] mb-6">
    <a href="/" class="hover:text-[var(--color-accent)]">首页</a>
    <span class="mx-2">/</span>
    <a href="/collections" class="hover:text-[var(--color-accent)]">收藏</a>
    <span class="mx-2">/</span>
    <a href={`/collections/${category}`} class="hover:text-[var(--color-accent)]">{categoryName}</a>
    <span class="mx-2">/</span>
    <span class="text-[var(--color-fg)]">{data.title}</span>
  </nav>

  <article>
    <header class="mb-10 pb-8 border-b border-[var(--color-border)]">
      <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight">{data.title}</h1>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-[var(--color-muted)]">
        {data.author && (
          <span>作者：{data.author}</span>
        )}
        {data.rating && (
          <span class="flex items-center gap-1">
            <span class="text-[var(--color-accent)]">{'★'.repeat(Math.round(data.rating))}</span>
            <span>{data.rating} / 5</span>
          </span>
        )}
        {data.status && (
          <span class="px-2 py-0.5 rounded-full bg-[var(--color-border)] text-xs">{data.status}</span>
        )}
      </div>
    </header>

    <div class="prose-content text-[var(--color-fg)] leading-[1.8] text-[17px]">
      <Content />
    </div>

    {data.link && (
      <div class="mt-12 pt-6 border-t border-[var(--color-border)]">
        <a
          href={data.link}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[var(--color-accent)] text-white text-sm hover:opacity-90 transition-opacity"
        >
          查看原始链接 ↗
        </a>
      </div>
    )}
  </article>
</BaseLayout>

---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@/config';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og/default.png' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.nameZh}` : `${SITE.title} · ${SITE.description}`;
const pageDescription = description ?? SITE.description;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImageURL = ogImage ? new URL(ogImage, SITE.url).toString() : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <!-- JSON-LD 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ange",
      "url": SITE.url,
      "jobTitle": "前端开发工程师",
      "email": SITE.email,
      "knowsAbout": ["Frontend Development", "React", "TypeScript", "Astro"],
    })} />

    <title>{pageTitle}</title>

    <!-- 暗色模式：首屏前注入，避免闪烁 -->
    <script is:inline>
      if (
        localStorage.theme === 'dark' ||
        (!('theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- 页面过渡路由（内置 prefetch，hover/视口预取新页） -->
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- 路由进度条（切换加载反馈） -->
    <div id="route-progress" aria-hidden="true"></div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-accent)] focus:text-[var(--color-accent-fg)] focus:rounded-md"
    >
      跳到主要内容
    </a>
    <Header />
    <main id="main-content" class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <slot />
    </main>
    <Footer />

    <!-- 回到顶部按钮 -->
    <button
      id="back-to-top"
      aria-label="回到顶部"
      class="fixed bottom-6 right-6 w-10 h-10 rounded-full bg-[var(--color-accent)] text-[var(--color-accent-fg)] shadow-lg opacity-0 invisible transition-all duration-300 hover:opacity-90 z-40"
    >
      <svg class="w-5 h-5 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
      </svg>
    </button>

    <!-- 统一 Toast（P2-9） -->
    <div id="toast-container" aria-live="polite"></div>
  </body>
</html>

<script>
  // 统一 Toast（P2-9）：window.showToast(message, type)
  // type: 'success' | 'error'，默认 success；自动 2.2s 消失
  window.showToast = function (message: string, type: 'success' | 'error' = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = 'toast' + (type === 'error' ? ' error' : '');
    toast.textContent = message;
    container.appendChild(toast);
    // 下一帧加 show 触发过渡
    requestAnimationFrame(() => requestAnimationFrame(() => toast.classList.add('show')));
    setTimeout(() => {
      toast.classList.remove('show');
      toast.classList.add('hide');
      setTimeout(() => toast.remove(), 220);
    }, 2200);
  };

  // 回到顶部按钮（ClientRouter 导航后 DOM 被替换，需每次新 DOM 就绪重新绑定）
  function bindCommon() {
    const backToTop = document.getElementById('back-to-top');
    if (backToTop && !backToTop.dataset.bound) {
      backToTop.dataset.bound = '1';
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          backToTop.classList.remove('opacity-0', 'invisible');
        } else {
          backToTop.classList.add('opacity-0', 'invisible');
        }
      });
      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }
  bindCommon();
  document.addEventListener('astro:page-load', bindCommon);

  // 路由进度条（P0-1 方案 C：点击立即反馈 + 新页补满 100%）
  const progress = document.getElementById('route-progress');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function startRouteProgress() {
    if (!progress || reduceMotion) return;
    sessionStorage.setItem('route-nav', '1');
    progress.style.transition = '';
    progress.classList.remove('active');
    progress.style.width = '0%';
    // 强制 reflow，保证 0 → 90% 的 transition 生效
    void progress.offsetWidth;
    progress.classList.add('active');
    progress.style.width = '90%';
  }

  function finishRouteProgress() {
    if (!progress || !sessionStorage.getItem('route-nav')) return;
    sessionStorage.removeItem('route-nav');
    // 新页进度条重新可见并补满 100%，停留 300ms 后淡出重置（保证用户能看到完成反馈）
    progress.classList.add('active');
    progress.style.width = '100%';
    setTimeout(() => {
      progress.style.transition = 'none';
      progress.style.width = '0%';
      progress.classList.remove('active');
      void progress.offsetWidth;
      progress.style.transition = '';
    }, 300);
  }

  // 捕获阶段拦截内部链接点击（先于 ClientRouter，点击即显示进度条）——只注册一次
  if (!window.__progressClickBound) {
    window.__progressClickBound = true;
    document.addEventListener(
      'click',
      (e) => {
        const el = e.target as Element | null;
        const a = el?.closest?.('a');
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || a.target === '_blank' || a.hasAttribute('download')) {
          return;
        }
        try {
          const url = new URL(a.href, location.href);
          if (url.origin !== location.origin) return;
        } catch {
          return;
        }
        startRouteProgress();
      },
      true,
    );
  }

  // ClientRouter 每次导航完成（新页 ready）后触发——只注册一次
  if (!window.__progressNavBound) {
    window.__progressNavBound = true;
    document.addEventListener('astro:page-load', finishRouteProgress);
  }

  // 键盘快捷键：按 / 快速打开搜索——只注册一次
  if (!window.__keyShortcutBound) {
    window.__keyShortcutBound = true;
    document.addEventListener('keydown', (e) => {
      // 忽略输入框/文本域中的按键
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {
        return;
      }
      if (e.key === '/') {
        e.preventDefault();
        window.location.href = '/search';
      }
    });
  }
</script>

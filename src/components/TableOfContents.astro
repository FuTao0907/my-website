---
import type { Heading } from '@/utils/posts';

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{headings.length >= 2 && (
  <aside class="hidden lg:block fixed right-8 top-1/2 -translate-y-1/2 w-56 max-h-[70vh] overflow-y-auto text-sm">
    <p class="text-xs font-medium text-[var(--color-muted)] uppercase tracking-wider mb-3">目录</p>
    <nav>
      <ul class="space-y-2">
        {headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class={`toc-link block text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors leading-relaxed ${
                h.depth === 3 ? 'pl-4 text-xs' : ''
              }`}
              data-slug={h.slug}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  // TOC 高亮当前章节
  const tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slug = entry.target.id;
          const link = document.querySelector(`.toc-link[data-slug="${slug}"]`);
          if (entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove('text-[var(--color-accent)]', 'font-medium'));
            link?.classList.add('text-[var(--color-accent)]', 'font-medium');
          }
        });
      },
      { rootMargin: '-20% 0px -80% 0px' }
    );

    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      const heading = document.getElementById(slug ?? '');
      if (heading) observer.observe(heading);
    });
  }
</script>
